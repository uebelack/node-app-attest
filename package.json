{
  "name": "node-app-attest",
  "version": "1.0.1",
  "description": "A JavaScript implementation of the App Attest protocol, which checks whether clients connecting to your server are valid instances of your app.",
  "keywords": [
    "app-attest",
    "apple",
    "attest",
    "attestation",
    "javascript",
    "mobile",
    "node",
    "security"
  ],
  "license": "MIT",
  "author": "David Übelacker",
  "repository": "https://github.com/uebelack/node-app-attest",
  "type": "module",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "scripts": {
    "test": "vitest run",
    "types": "tsc",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt ."
  },
  "dependencies": {
    "asn1js": "^3.1.0",
    "cbor": "^10.0.12",
    "pkijs": "^3.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-istanbul": "^5.1.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.18.0"
}
