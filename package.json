{
  "name": "node-app-attest",
  "version": "1.0.1",
  "description": "A JavaScript implementation of the App Attest protocol, which checks whether clients connecting to your server are valid instances of your app.",
  "keywords": [
    "app-attest",
    "apple",
    "attest",
    "attestation",
    "javascript",
    "mobile",
    "node",
    "security"
  ],
  "license": "MIT",
  "author": "David Übelacker",
  "repository": "https://github.com/uebelack/node-app-attest",
  "type": "module",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "types": "tsc",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt ."
  },
  "dependencies": {
    "asn1js": "^3.0.7",
    "cbor": "^10.0.11",
    "pkijs": "^3.3.3"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "packageManager": "pnpm@12.18.0"
}
